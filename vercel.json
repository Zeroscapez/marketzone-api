{
    "version": 2,
    "builds": [
      {
        "src": "./index.js",
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/(.*)",
        "dest": "/"
      }
    ],
    "headers": [
      {
        "src": "/(.*)",
        "headers": [
    
          { "key": "Access-Control-Allow-Origin", 
          "value": "*" }
         
        ]
      }
    ]
  }
  